# ==============================================================================
# NHÀ LO 24H - MẪU BIẾN MÔI TRƯỜNG PHÁT TRIỂN (.env.example)
# Sao chép file này thành .env và điền các giá trị phù hợp trên máy cá nhân:
#   copy .env.example .env (Windows) hoặc cp .env.example .env (Linux/macOS)
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env CHỨA SECRET THẬT LÊN GIT REPOSITORY!
# ==============================================================================

# --- Cấu hình PostgreSQL Database Container ---
POSTGRES_ROOT_USER=postgres
POSTGRES_ROOT_PASSWORD=postgres_root_dev_secret

# --- Cấu hình kết nối Database cho Backend ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nha_lo_24h
DB_USERNAME=nhalo_app
DB_PASSWORD=nhalo_app_dev_secret

# --- Cấu hình Backend Spring Boot Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# --- Cấu hình CORS (cho phép frontend gọi API) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Cấu hình dự kiến cho Authentication & JWT (dành cho giai đoạn tiếp theo) ---
JWT_SECRET=dev_only_secret_key_minimum_256_bits_for_hmac_sha256_testing_only
JWT_EXPIRATION_MS=86400000
